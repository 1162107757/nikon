CLOUDBASE_ENV_ID=nikon-d8girdjsr252fd90e
CLOUDBASE_API_ORIGIN=https://nikon-d8girdjsr252fd90e.api.tcloudbasegateway.com
CLOUDBASE_STORAGE_BUCKET=nikon-presets
PUBLIC_BASE_URL=https://nikon-d8girdjsr252fd90e-1252602548.ap-shanghai.app.tcloudbase.com
# Additional browser entrypoints, comma-separated exact HTTPS origins; the public base origin remains allowed.
# Keep PUBLIC_BASE_URL unchanged during domain onboarding to preserve existing Android update/avatar URLs.
# Example: https://admin.example.com,https://www.example.com (no trailing slash or wildcards).
ALLOWED_BROWSER_ORIGINS=
BASE_PATH=/preset-library
# Server only. Inject through the cloud function configuration, never admin assets or Android.
CLOUDBASE_SERVICE_KEY=
# Server only. Use a stable random secret of at least 24 characters; never commit the real value.
CHALLENGE_SECRET=
# Default does not trust XFF. Change only after verifying the deployed gateway chain.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# QQ Connect mobile AppID; public identifier, never an AppKey.
# Ordinary deploy preserves cloud settings; explicit QQ configuration is required.
QQ_APP_ID=1105984855
