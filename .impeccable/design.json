  "components": [
    {
      "name": "Charcoal Action",
      "kind": "button",
      "refersTo": "primary-button",
      "description": "HueTheme 原生主动作的垂直渐变；dp/sp 在浏览器标本中按 CSS px 近似，hover/focus 仅提供标本交互反馈，不能替代原生 RippleDrawable。",
      "html": "<button class=\"ds-action\">导入到 C3</button>",
      "css": ".ds-action{box-sizing:border-box;min-height:48px;padding:10px 16px;border:0;border-radius:26px;background:linear-gradient(#46413B,#27241F);color:#FFFFFF;font:700 15px system-ui,sans-serif;cursor:pointer}.ds-action:disabled{background:#EFEDE9;color:#706A63;cursor:default}.ds-action:focus-visible{outline:2px solid #B3432D;outline-offset:3px}.ds-action:hover{filter:brightness(.98)}.ds-action:active{filter:brightness(.92)}@media(prefers-color-scheme:dark){.ds-action{background:linear-gradient(#F0E8DF,#DAD0C5);color:#26211C}.ds-action:disabled{background:#33302C;color:#BAB1A7}}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "refersTo": "secondary-button",
      "description": "暖灰次动作与正文色；原生高度至少 48dp。此 HTML 为视觉标本，不执行业务操作。",
      "html": "<button class=\"ds-secondary\">取消</button>",
      "css": ".ds-secondary{box-sizing:border-box;min-height:48px;padding:10px 16px;border:0;border-radius:26px;background:#EFEDE9;color:#262320;font:400 15px system-ui,sans-serif;cursor:pointer}.ds-secondary:disabled{color:#706A63;cursor:default}.ds-secondary:focus-visible{outline:2px solid #B3432D;outline-offset:3px}.ds-secondary:hover{filter:brightness(.98)}.ds-secondary:active{filter:brightness(.92)}@media(prefers-color-scheme:dark){.ds-secondary{background:#33302C;color:#F6F1EB}.ds-secondary:disabled{color:#BAB1A7}}"
    },
    {
      "name": "Native Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "社区／账号表单的暖灰 14dp 字段、16sp 正文；浏览器标本保留标签与焦点，不模拟 Android 输入法或验证流程。",
      "html": "<label class=\"ds-field-label\" for=\"ds-preset-name\">预设名称</label><input class=\"ds-field\" id=\"ds-preset-name\" placeholder=\"输入名称\" value=\"暖阳胶片\">",
      "css": ".ds-field-label{display:block;margin:0 0 8px;color:#262320;font:700 13px system-ui,sans-serif}.ds-field{box-sizing:border-box;display:block;max-width:100%;min-height:52px;padding:12px 14px;border:0;border-radius:14px;background:#EFEDE9;color:#262320;font:400 16px system-ui,sans-serif}.ds-field::placeholder{color:#706A63;opacity:1}.ds-field:focus-visible{outline:2px solid #B3432D;outline-offset:2px}.ds-field:hover{filter:brightness(.99)}.ds-field:disabled{color:#706A63}@media(prefers-color-scheme:dark){.ds-field-label{color:#F6F1EB}.ds-field{background:#33302C;color:#F6F1EB}.ds-field::placeholder{color:#BAB1A7}.ds-field:focus-visible{outline-color:#F3B493}}"
    },
    {
      "name": "Four Destinations",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "当前四入口导航的手机悬浮标本：外栏圆角为实际栏高的一半、最大宽 360dp 且左右至少各 24dp，基础高 68dp，安全区内底距 14dp；选中项以实际单元高度一半为圆角的杏色底完整包住 54×26dp 图标槽和下方 11sp 名称，图标槽没有独立底色。水平导航填满外栏、四边均内缩 5dp；四项等宽并填满内侧高度，单元左右外边距为 0，首尾内外弧线同心。各项上下内边距 4dp、最小高 58dp，名称上间距 2dp，图标和名称居中。原生在宽度≥600dp 保持 80dp 侧栏及 16dp 圆角图标选中底；字号增长和材料降级见 DESIGN.md。CSS 的背景模糊与阴影仅近似原生 GlassBar。 相册导航留位在宽度<600dp 时为 104dp 加 24 倍字号增量，≥600dp 为 92dp 加 20 倍增量；增量基数为 max(0, fontScale−1.2)。预设加号仅紧凑且≥600dp 时用 16dp 底距，其余为 104dp 加 24 倍增量；预设列表同条件用 76dp，其余为 108dp 加 24 倍增量，增量均取整。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button class=\"ds-nav-item\" aria-current=\"page\"><span class=\"ds-nav-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><circle cx=\"9\" cy=\"8\" r=\"1.5\"/><path d=\"m5 17 5-6 4 4 3-3 3 4\"/></svg></span><span>预设</span></button><button class=\"ds-nav-item\"><span class=\"ds-nav-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7h4l2-3h6l2 3h4v13H3z\"/><circle cx=\"12\" cy=\"13\" r=\"4\"/></svg></span><span>同步</span></button><button class=\"ds-nav-item\"><span class=\"ds-nav-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4H3v14\"/><rect x=\"7\" y=\"8\" width=\"14\" height=\"13\" rx=\"1\"/><path d=\"m8 18 4-4 3 3 3-4 3 5\"/></svg></span><span>相册</span></button><button class=\"ds-nav-item\"><span class=\"ds-nav-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m10 3-.6 2.4-2 .9L5 5.6 3.6 8l1.7 1.7-.2 2.2L3 13l1 2.7 2.5.1 1.5 1.6-.1 2.4 2.8.8 1.4-2 2.2-.3 1.9 1.5 2.2-1.8-.8-2.3.6-2.1 2.4-.8-.2-2.9-2.3-.6-1.1-1.9.4-2.4-2.6-1.2L13.2 5l-2.2-.2z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></span><span>设置</span></button></nav>",
      "css": ".ds-nav{box-sizing:border-box;display:flex;align-items:stretch;gap:0;width:360px;max-width:calc(100% - 48px);height:68px;margin:0 auto 14px;padding:5px;border:0;border-radius:999px;background:rgba(250,250,248,.9607843137);box-shadow:inset 0 0 0 .5px rgba(48,43,35,.0941176471),0 8px 16px rgba(48,43,35,.1882352941);backdrop-filter:blur(18px)}.ds-nav-item{box-sizing:border-box;display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:54px;height:100%;min-height:58px;margin:0;padding:4px 8px;border:0;border-radius:999px;background:transparent;color:#706A63;font:400 11px system-ui,sans-serif;cursor:pointer}.ds-nav-icon{display:grid;place-items:center;width:54px;height:26px;border-radius:16px}.ds-nav-item[aria-current]{background:#F4D6C0;color:#262320;font-weight:700}.ds-nav-item:hover,.ds-nav-item:active{background:#F4D6C0}.ds-nav-item:focus-visible{outline:2px solid #B3432D;outline-offset:1px}@media(prefers-color-scheme:dark){.ds-nav{background:rgba(41,39,36,.9411764706);box-shadow:inset 0 0 0 .5px rgba(255,255,255,.2078431373),0 8px 16px rgba(0,0,0,.3764705882)}.ds-nav-item{color:#BAB1A7}.ds-nav-item[aria-current]{background:#51382D;color:#F6F1EB}.ds-nav-item:hover,.ds-nav-item:active{background:#51382D}.ds-nav-item:focus-visible{outline-color:#F3B493}}"
    },
    {
      "name": "Selected Category",
      "kind": "chip",
      "refersTo": "category-selected",
      "description": "分类的杏底／深陶土选中字配对；标本采用原生 48dp 目标与 13sp 字号，selected 状态必须和颜色共同表达。",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">全部</button><button class=\"ds-chip\" aria-pressed=\"false\">风景</button>",
      "css": ".ds-chip{min-height:48px;margin-right:4px;padding:9px 14px;border:0;border-radius:24px;background:#EFEDE9;color:#262320;font:400 13px system-ui,sans-serif;cursor:pointer}.ds-chip[aria-pressed=true]{background:#F4D6C0;color:#85311F;font-weight:700}.ds-chip:focus-visible{outline:2px solid #B3432D;outline-offset:3px}.ds-chip:hover{filter:brightness(.98)}.ds-chip:active{filter:brightness(.92)}@media(prefers-color-scheme:dark){.ds-chip{background:#33302C;color:#F6F1EB}.ds-chip[aria-pressed=true]{background:#51382D;color:#F3B493}}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "22dp 设置分组与 66dp 行；浅色 2dp 原生 elevation 用柔和 CSS 影子作视觉近似，深色平面。示例未连接状态不代表真实硬件状态。",
      "html": "<section class=\"ds-settings\"><button class=\"ds-settings-row\"><span class=\"ds-settings-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7h4l2-3h6l2 3h4v13H3z\"/><circle cx=\"12\" cy=\"13\" r=\"4\"/></svg></span><span class=\"ds-settings-copy\"><strong>Wi-Fi 无线连接</strong><small>尼康相机 / 富士</small></span><span aria-hidden=\"true\">›</span></button><button class=\"ds-settings-row\"><span class=\"ds-settings-icon\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4H3v14\"/><rect x=\"7\" y=\"8\" width=\"14\" height=\"13\" rx=\"1\"/><path d=\"m8 18 4-4 3 3 3-4 3 5\"/></svg></span><span class=\"ds-settings-copy\"><strong>预览模板</strong><small>内置照片 · 模板模拟</small></span><span aria-hidden=\"true\">›</span></button></section>",
      "css": ".ds-settings{width:320px;max-width:100%;overflow:hidden;border-radius:22px;background:#FFFFFF;box-shadow:0 2px 4px rgba(48,43,35,.07);color:#262320;font-family:system-ui,sans-serif}.ds-settings-row{box-sizing:border-box;display:flex;align-items:center;gap:11px;width:100%;min-height:66px;padding:11px 14px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.ds-settings-row+.ds-settings-row{border-top:1px solid #E4DFD8}.ds-settings-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:#EFEDE9}.ds-settings-icon svg{width:18px;height:18px}.ds-settings-copy{flex:1}.ds-settings-copy strong{display:block;font-size:14px;font-weight:400}.ds-settings-copy small{display:block;margin-top:3px;color:#706A63;font-size:11px}.ds-settings-row:hover,.ds-settings-row:active{background:#F4D6C0}.ds-settings-row:focus-visible{outline:2px solid #B3432D;outline-offset:-3px}@media(prefers-color-scheme:dark){.ds-settings{background:#292724;color:#F6F1EB;box-shadow:none}.ds-settings-icon{background:#33302C}.ds-settings-copy small{color:#BAB1A7}.ds-settings-row+.ds-settings-row{border-color:#4C4640}.ds-settings-row:hover,.ds-settings-row:active{background:#51382D}}"
    },
    {
      "name": "Preset Source",
      "kind": "nav",
      "refersTo": "source-pill",
      "description": "48dp 来源目标内的 40dp 卡片胶囊、13sp 文字与 1dp 轻抬升；浏览器标本只展示当前来源，不加载列表。",
      "html": "<div class=\"ds-source\" role=\"group\" aria-label=\"预设来源\"><button class=\"ds-source-button\" aria-pressed=\"false\">在线预设</button><button class=\"ds-source-button\" aria-pressed=\"true\">我的预设</button></div>",
      "css": ".ds-source{box-sizing:border-box;display:flex;align-items:center;width:320px;max-width:100%;min-height:48px;padding:0 3px;border-radius:25px;background:rgba(255,255,255,.4392156863);font-family:system-ui,sans-serif}.ds-source-button{box-sizing:border-box;flex:1;min-height:40px;margin:4px 2px;padding:0 12px;border:0;border-radius:19px;background:transparent;color:#706A63;font:400 13px system-ui,sans-serif;cursor:pointer}.ds-source-button[aria-pressed=true]{background:#FFFFFF;color:#262320;font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,.1)}.ds-source-button:focus-visible{outline:2px solid #B3432D;outline-offset:3px}.ds-source-button:hover{filter:brightness(.98)}.ds-source-button:active{filter:brightness(.92)}@media(prefers-color-scheme:dark){.ds-source{background:rgba(81,56,45,.3764705882)}.ds-source-button{color:#BAB1A7}.ds-source-button[aria-pressed=true]{background:#292724;color:#F6F1EB}}"
    },
    {
      "name": "Photo Overlay Controls",
      "kind": "custom",
      "refersTo": "photo-control",
      "description": "照片上收藏／更多／图标对比的 48dp 目标与共享 #B8262320 Android ARGB 衬底。标本白底刻意演示最差背景，收藏与更多间隔 8dp；不含照片或原生手势实现。",
      "html": "<div class=\"ds-photo-controls\"><button class=\"ds-photo-control\" aria-label=\"收藏照片\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z\"/></svg></button><button class=\"ds-photo-control\" aria-label=\"更多照片操作和重置\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"5\" r=\"1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"12\" r=\"1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"19\" r=\"1\" fill=\"currentColor\"/></svg></button><button class=\"ds-photo-control\" aria-label=\"按住看原图，松开恢复预设效果\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v18M4 6h16v13H4z\"/></svg></button></div>",
      "css": ".ds-photo-controls{display:flex;align-items:center;gap:8px;padding:12px;background:#FFFFFF}.ds-photo-control{box-sizing:border-box;display:grid;place-items:center;width:48px;height:48px;padding:12px;border:0;border-radius:24px;background:rgba(38,35,32,.7215686275);color:#FFFFFF;cursor:pointer}.ds-photo-control:hover{background:rgba(38,35,32,.80)}.ds-photo-control:active{background:rgba(38,35,32,.93)}.ds-photo-control:focus-visible{outline:2px solid #FFFFFF;outline-offset:-3px;box-shadow:0 0 0 2px #262320}"
