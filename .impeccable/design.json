  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "primary-button",
      "description": "HTML specimen of the native 52dp-minimum primary action; Android source remains normative.",
      "html": "<button class=\"ds-button ds-primary\">连接相机</button>",
      "css": ".ds-button{font:700 15px system-ui,sans-serif;min-height:52px;padding:10px 16px;border:0;border-radius:26px;cursor:pointer}.ds-button:hover{filter:brightness(.97)}.ds-button:focus-visible{outline:2px solid #0065DC;outline-offset:3px}.ds-button:active{background:#E9F1FF;color:#0065DC}.ds-button:disabled{opacity:.5;cursor:default}.ds-primary{background:#0065DC;color:#FFFFFF}@media(prefers-color-scheme:dark){.ds-primary{background:#8DBBFF;color:#07244A}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "secondary-button",
      "description": "Quiet white-card action with blue text; full native component uses RippleDrawable.",
      "html": "<button class=\"ds-button ds-secondary\">打开系统 Wi-Fi 设置</button>",
      "css": ".ds-button{font:700 15px system-ui,sans-serif;min-height:52px;padding:10px 16px;border:0;border-radius:26px;cursor:pointer}.ds-button:hover{filter:brightness(.97)}.ds-button:focus-visible{outline:2px solid #0065DC;outline-offset:3px}.ds-button:active{background:#E9F1FF;color:#0065DC}.ds-button:disabled{opacity:.5;cursor:default}.ds-secondary{background:#FFFFFF;color:#0065DC}@media(prefers-color-scheme:dark){.ds-secondary{background:#2A2E34;color:#8DBBFF}}"
    },
    {
      "name": "Connection Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Static HTML translation of the native 16sp address field and 14dp corners.",
      "html": "<label class=\"ds-field-label\">IP 地址<input class=\"ds-field\" value=\"192.168.1.1\" aria-label=\"相机 IPv4 地址\"></label>",
      "css": ".ds-field-label{display:grid;gap:8px;color:#626B78;font:13px system-ui,sans-serif}.ds-field{font:16px system-ui,sans-serif;color:#20242B;background:#EEF0F4;border:1px solid #D9DEE6;border-radius:14px;padding:12px 14px;min-height:24px}.ds-field:hover{border-color:#626B78}.ds-field:focus-visible{outline:2px solid #0065DC;outline-offset:2px}.ds-field:disabled{opacity:.5}@media(prefers-color-scheme:dark){.ds-field-label{color:#ADB6C3}.ds-field{color:#F4F5F7;background:#30353D;border-color:#474E58}}"
    },
    {
      "name": "Source Selection",
      "kind": "chip",
      "refersTo": "source-pill",
      "description": "216dp-wide native source selection: 48dp hit area around a 34dp visible pill.",
      "html": "<div class=\"ds-sources\" role=\"tablist\" aria-label=\"预设来源\"><button class=\"ds-source ds-selected\" role=\"tab\" aria-selected=\"true\">我的预设</button><button class=\"ds-source\" role=\"tab\" aria-selected=\"false\">在线预设</button></div>",
      "css": ".ds-sources{display:flex;width:216px;height:48px;align-items:center;gap:4px}.ds-source{position:relative;isolation:isolate;flex:1;height:48px;border:0;background:transparent;color:#626B78;font:13px system-ui,sans-serif;cursor:pointer}.ds-source:before{content:'';position:absolute;inset:7px 0;z-index:-1;border-radius:19px}.ds-selected{color:#20242B;font-weight:700}.ds-selected:before{background:#FFFFFF;box-shadow:0 1px 2px #20242B10}.ds-source:hover:before,.ds-source:active:before{background:#E9F1FF}.ds-source:focus-visible{outline:2px solid #0065DC;border-radius:19px;outline-offset:2px}@media(prefers-color-scheme:dark){.ds-source{color:#ADB6C3}.ds-selected{color:#F4F5F7}.ds-selected:before{background:#2A2E34}.ds-source:hover:before,.ds-source:active:before{background:#263D5A}}"
    },
    {
      "name": "Floating Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Native three-destination navigation specimen. This HTML preview uses its opaque fallback; actual API31+ sampling is documented in DESIGN.md.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button class=\"ds-nav-item ds-current\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8\" cy=\"8\" r=\"1.6\"/><path d=\"m4 18 6-6 4 4 3-4 4 5\"/></svg><span>预设</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"6\" y=\"6\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M3 17H2V2h15v1m-10 15 5-5 4 4 3-3 3 4\"/></svg><span>相册</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3.2\"/><path d=\"m9 3-1 3-3 1-2 2 2 3-2 3 2 2 3 1 1 3h6l1-3 3-1 2-2-2-3 2-3-2-2-3-1-1-3Z\"/></svg><span>设置</span></button></nav>",
      "css": ".ds-nav{display:flex;gap:2px;box-sizing:border-box;width:360px;max-width:100%;min-height:68px;padding:5px;border-radius:34px;background:#FFFFFF;border:1px solid #D9DEE6}.ds-nav-item{flex:1;min-height:58px;display:grid;place-content:center;justify-items:center;gap:3px;padding:7px 8px;border:0;border-radius:30px;color:#626B78;background:transparent;font:10px system-ui,sans-serif;cursor:pointer}.ds-current{background:#E9F1FF;color:#0065DC;font-weight:700}.ds-nav-item:hover,.ds-nav-item:active{background:#E9F1FF}.ds-nav-item:focus-visible{outline:2px solid #0065DC;outline-offset:1px}@media(prefers-color-scheme:dark){.ds-nav{background:#2A2E34;border-color:#474E58}.ds-nav-item{color:#ADB6C3}.ds-current,.ds-nav-item:hover,.ds-nav-item:active{background:#263D5A;color:#8DBBFF}}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "Continuous native settings group with inset dividers and minimum 66dp action rows.",
      "html": "<div class=\"ds-group\"><button class=\"ds-row\"><span>Wi-Fi 无线连接<small>浏览照片、导入预设</small></span><span aria-hidden=\"true\">›</span></button><button class=\"ds-row\"><span>USB 数据线连接<small>导入预设</small></span><span aria-hidden=\"true\">›</span></button></div>",
      "css": ".ds-group{overflow:hidden;border-radius:22px;background:#FFFFFF;min-width:260px}.ds-row{box-sizing:border-box;width:100%;min-height:66px;border:0;padding:11px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;color:#20242B;background:transparent;font:14px system-ui,sans-serif;cursor:pointer}.ds-row+ .ds-row{border-top:1px solid #D9DEE6}.ds-row small{display:block;margin-top:3px;color:#626B78;font-size:11px}.ds-row:hover,.ds-row:active{background:#E9F1FF}.ds-row:focus-visible{outline:2px solid #0065DC;outline-offset:-3px}@media(prefers-color-scheme:dark){.ds-group{background:#2A2E34}.ds-row{color:#F4F5F7}.ds-row small{color:#ADB6C3}.ds-row+ .ds-row{border-color:#474E58}.ds-row:hover,.ds-row:active{background:#263D5A}}"
    },
    {
      "name": "Hold to Compare",
      "kind": "button",
      "refersTo": "hold-to-compare",
      "description": "Static HTML specimen of the native detail's shortened 原图 capsule: 48dp high with 12dp bottom/end margins. Native HoldToCompare retains full hold/release and keyboard/accessibility explanations; this specimen does not implement gestures.",
      "html": "<button class=\"ds-compare\" aria-label=\"按住看原图，松开恢复预设效果。使用辅助功能或键盘时，点击可切换原图，再次点击恢复\" aria-pressed=\"false\">原图</button>",
      "css": ".ds-compare{box-sizing:border-box;height:48px;margin:12px;padding:0 16px;border:1px solid rgba(255,255,255,.2156862745);border-radius:24px;background:rgba(26,29,35,.8431372549);color:#FFFFFF;font:500 13px system-ui,sans-serif;cursor:pointer}.ds-compare:hover{background:rgba(26,29,35,.8431372549)}.ds-compare:focus-visible{border:2px solid #FFFFFF;outline:0}.ds-compare:active,.ds-compare[aria-pressed=true]{background:rgba(26,29,35,.9333333333)}.ds-compare:disabled{color:#D6DAE1;cursor:default}"
    },
    {
      "name": "Current Camera Card",
      "kind": "card",
      "refersTo": "camera-card",
      "description": "Truthful disconnected camera-card specimen; its presence does not assert a connected camera.",
      "html": "<section class=\"ds-camera\"><div class=\"ds-camera-title\"><svg viewBox=\"0 0 24 24\" width=\"23\" height=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7h4l2-3h6l2 3h4v14H3Z\"/><circle cx=\"12\" cy=\"13\" r=\"4\"/></svg><div><small>相机</small><strong>尚未连接相机</strong></div></div><p><span class=\"ds-dot\"></span>未连接</p><footer>选择下方连接方式</footer></section>",
      "css": ".ds-camera{min-width:260px;box-sizing:border-box;padding:18px 18px 8px;border-radius:26px;background:#FFFFFF;color:#20242B;font:11px system-ui,sans-serif}.ds-camera-title{display:flex;gap:12px;align-items:center}.ds-camera-title>svg{box-sizing:content-box;padding:10px;background:#F7F8FA;border-radius:15px;color:#626B78}.ds-camera small{display:block;color:#626B78}.ds-camera strong{display:block;margin-top:4px;font-size:19px}.ds-camera p{display:flex;align-items:center;gap:6px;padding:10px 0 8px;color:#626B78}.ds-dot{width:6px;height:6px;border-radius:50%;background:#626B78}.ds-camera footer{border-top:1px solid #D9DEE6;padding:12px 0;color:#626B78}@media(prefers-color-scheme:dark){.ds-camera{background:#2A2E34;color:#F4F5F7}.ds-camera-title>svg{background:#22252A;color:#ADB6C3}.ds-camera small,.ds-camera p,.ds-camera footer{color:#ADB6C3}.ds-camera footer{border-color:#474E58}.ds-dot{background:#ADB6C3}}"
    },
    {
      "name": "Read-only Tone Curve",
      "kind": "custom",
      "refersTo": "tone-curve",
      "description": "Static visual specimen using all 257 actual samples from the hand-authored PreviewTone NCP fixture (tests/tools/SyntheticPresetPreview.java), never bundled as a preset. Native ToneCurveView reads the selected hash-verified NCP, grows from 188dp with font scale and has real loading/retry states; this fixed-size HTML specimen does not implement parsing or state behavior. Both dashed reference strokes match native alpha 200.",
